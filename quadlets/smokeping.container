[Unit]
Description=Smokeping

[Container]
Image=docker.io/linuxserver/smokeping:2.9.0
PublishPort=192.168.0.1:8000:80
HostName=smokeping
AddCapability=NET_RAW
Environment=TZ=Europe/Stockholm
Volume=%h/configs/smokeping/config:/etc/smokeping/config
Volume=smokeping-data.volume:/data

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
